(defalias
  ;; tap-hold argument order:
  ;; 1. tap timeout
  ;; 2. hold timeout
  ;; 3. tap action
  ;; 4. hold action

    E&C (tap-hold 100 100 esc lctl) ;; caps lock -> tap: esc, hold: ctrl
)