;;==============================================================
;;jolitp kanata keyboard confguration for G613 wireless keyboard
;;===============================================================

;; default layer - upside down
;;
;; The names can be found here:
;; https://github.com/jtroo/kanata/blob/7e5039a170096a81a4a78ba5cf50b503c510be01/parser/src/keys/mod.rs#L139
;; kanata/parser/src/keys/mod.rs
;; (above link is for a specific version of the code.
;;  In the future, there may be a newer version)
(deflayer qwerty
;; (deflayer name
;;  C1    C2    C3    C4    C5    C6    C7    C8       C9    C10    C11   C12   C13   C14   C15   C16
;; ┌────┐┌────┐┌────┐┌────┐┌────┐┌────────────────    ──────────────────────────────┐┌────┐┌────┐┌────┐
;;  rght  down  left  rctl  ralt  spc                 #|spc|#                         lalt  lmet  lctl  ;; R1
    esc   f1    f2    f3    f4    @L_GMs                                                  vold  volu  del
;; └────┘└────┘└────┘└────┘└────┘└───────────────     ──────────────────────────────┘└────┘└────┘└────┘
;; ┌────┐┌────┐┌────────┐┌────┐┌────┐┌────┐┌────┐     ┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌───────────┐
;;  pgdn  up    rsft      /     .     ,     m          n     b     v     c     x     z     lsft         ;; R2
    `     1     2         3     4     5     6          7     8     9     0     -     =     bspc
;; └────┘└────┘└────────┘└────┘└────┘└────┘└────┘     └────┘└────┘└────┘└────┘└────┘└────┘└───────────┘
;; ┌────┐┌───────────┐┌────┐┌────┐┌────┐┌────┐┌────┐    ┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌─────────┐
;;  pgup  ret          '     ;     l     k     j         h     g     f     d     s     a     caps       ;; R3
    tab   tab          q     w     e     r     t         y     u     i     o     p     [     ]
;; └────┘└───────────┘└────┘└────┘└────┘└────┘└────┘    └────┘└────┘└────┘└────┘└────┘└────┘└─────────┘
;; ┌────┐┌───────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐    ┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌───────┐
;;  end   \        ]     [     p     o     i     u         y     t     r     e     w     q     tab      ;; R4
    @E&C  @E&C     @E&C  a     s     d     f     g         h     j     k     l     ;     @sqd  return
;; └────┘└───────┘└────┘└────┘└────┘└────┘└────┘└────┘    └────┘└────┘└────┘└────┘└────┘└────┘└───────┘
;; ┌────┐┌──────────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐    ┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐
;;  home  bspc        =     -     0     9     8     7         6     5     4     3     2     1     grv   ;; R5
    lsft  lsft        \     z     x     c     v     b         n     m     ,     .     /     rsft  lrld
;; └────┘└──────────┘└────┘└────┘└────┘└────┘└────┘└────┘    └────┘└────┘└────┘└────┘└────┘└────┘└────┘
;; ┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐    ┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐┌────┐
;;  del   volu  vold  f12   f11   f10   f9    f8    f7        f6    f5    f4    f3    f2    f1    esc   ;; R6
    lctl  XX    XX    lctl  lalt  @E&Md @_&Nv @T&Ms spc       @B&Nm @E&Sy @D&F1 ralt  met   XX    rctrl
;; └────┘└────┘└────┘└────┘└────┘└────┘└────┘└────┘└────┘    └────┘└────┘└────┘└────┘└────┘└────┘└────┘
;;  Left Half                                                 Right Half
)