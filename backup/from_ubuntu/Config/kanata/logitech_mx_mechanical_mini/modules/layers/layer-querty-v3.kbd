;; ============================ template for empty layer ============================
;;
;; (deflayer name
;;  _    _    _    _    _    _         _    _    _    _    _    _    _    _    _    _
;;  _    _    _    _    _    _         _    _    _    _    _    _    _    _         _
;;  _    _    _    _    _    _         _    _    _    _    _    _    _    _         _
;;  _    _    _    _    _    _         _    _    _    _    _    _         _         _
;;  _    _    _    _    _    _         _    _    _    _    _    _              _    _
;;  _    _    _                  _                    _         _         _    _    _
;; )
;; ==================================================================================

;; The default layer
(deflayer qwerty
  esc  f1  f2   f3   f4   f5        f6   f7   f8   f9   f10   f11  f12   vold volu del
  grv  1    2    3    4    5         6    7    8    9    0     -    =    bspc      home
  tab  q    w    e    r    t         y    u    i    o    p     [    ]    \         end
  @E&C @a-m @s-a @d-c @f-s g         h    @j-s @k-c @l-a @sc-m @sqd      ret       pgup
  @lsl z    x    c    v    b         n    m    ,    .    /     @rsl           lrld pgdn
  lctl lmet lalt               @smv                 ralt       rctl      lrld lrld lrld
)
