(defcfg

  ;;linux-dev usb-Compx_2.4G_Wireless_Receiver-event-if01
  ;;linux-dev usb-Compx_2.4G_Wireless_Receiver-event-mouse
  ;;linux-dev usb-Compx_2.4G_Wireless_Receiver-if01-event-kbd
  ;;linux-dev usb-Compx_2.4G_Wireless_Receiver-mouse
  ;;linux-dev usb-DYGMA_DEFY_8954F42394A56985-if02-event-kbd
  ;;linux-dev usb-DYGMA_DEFY_8954F42394A56985-if02-event-mouse
  ;;linux-dev usb-DYGMA_DEFY_8954F42394A56985-if02-mouse
  ;;linux-dev usb-ITE_Tech._Inc._ITE_Device_8176_-event-if00
  ;;linux-dev usb-ITE_Tech._Inc._ITE_Device_8176_-event-kbd

  linux-dev
  (
    ;; /dev/input/by-id/usb-Compx_2.4G_Wireless_Receiver-event-if01 ;; nothing
    ;; /dev/input/by-id/usb-Compx_2.4G_Wireless_Receiver-event-mouse   ;; scroll wheel
    /dev/input/by-id/usb-Compx_2.4G_Wireless_Receiver-if01-event-kbd ;; side buttons
    ;; /dev/input/by-id/usb-Compx_2.4G_Wireless_Receiver-mouse
    ;; /dev/input/by-id/usb-DYGMA_DEFY_8954F42394A56985-if02-event-kbd
    ;; /dev/input/by-id/usb-DYGMA_DEFY_8954F42394A56985-if02-event-mouse
    ;; /dev/input/by-id/usb-DYGMA_DEFY_8954F42394A56985-if02-mouse
    ;; /dev/input/by-id/usb-ITE_Tech._Inc._ITE_Device_8176_-event-if00
    ;; /dev/input/by-id/usb-ITE_Tech._Inc._ITE_Device_8176_-event-kbd
  )
  process-unmapped-keys yes
)

(defsrc
  1 2   3
  4 5   6
  7 8   9
  0 kp+ kp-
)

(deflayer default
  lalt tab bspc
  lctl esc del
  lmet ret mbck
  lsft spc mfwd
)












